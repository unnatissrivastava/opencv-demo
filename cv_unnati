import sys
import cv2
import numpy as np
from matplotlib import pyplot as plt

print("OpenCV Version:", cv2.__version__)

# Pass an image path as a command-line argument, or default to "sample.jpg"
# Example: python cv_unnati.py path/to/your/image.jpg
IMAGE_PATH = sys.argv[1] if len(sys.argv) > 1 else "sample.jpg"

img = cv2.imread(IMAGE_PATH, 1)

if img is None:
    raise FileNotFoundError(f"Could not load image at '{IMAGE_PATH}'. Check the path and try again.")

print("Image Shape:", img.shape)

# 1. READING & DISPLAYING IMAGE
plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
plt.title("Original Image")
plt.axis('off')
plt.show()

# 2. RESIZING
resized = cv2.resize(img, (400, 400), interpolation=cv2.INTER_AREA)

plt.imshow(cv2.cvtColor(resized, cv2.COLOR_BGR2RGB))
plt.title("Resized Image 400x400")
plt.axis('off')
plt.show()

# 3. COLOUR SPACE CONVERSION
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.imshow(gray, cmap='gray')
plt.title("Grayscale")

plt.subplot(1, 2, 2)
plt.imshow(cv2.cvtColor(hsv, cv2.COLOR_HSV2RGB))
plt.title("HSV Image")
plt.show()

# 4. DRAWING FUNCTIONS
canvas = img.copy()

cv2.line(canvas, (50, 50), (300, 50), (255, 0, 0), 3)
cv2.rectangle(canvas, (50, 80), (300, 200), (0, 255, 0), 3)
cv2.circle(canvas, (200, 300), 50, (0, 0, 255), -1)
cv2.putText(canvas, "OpenCV Demo", (50, 350),
            cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 3)

plt.imshow(cv2.cvtColor(canvas, cv2.COLOR_BGR2RGB))
plt.title("Shapes & Text")
plt.axis('off')
plt.show()

# 5. BLURRING METHODS
avg = cv2.blur(img, (7, 7))
gauss = cv2.GaussianBlur(img, (7, 7), 0)
median = cv2.medianBlur(img, 7)
bilateral = cv2.bilateralFilter(img, 9, 75, 75)

images = [avg, gauss, median, bilateral]
titles = ["Average", "Gaussian", "Median", "Bilateral"]

plt.figure(figsize=(12, 6))
for i in range(4):
    plt.subplot(2, 2, i + 1)
    plt.imshow(cv2.cvtColor(images[i], cv2.COLOR_BGR2RGB))
    plt.title(titles[i])
    plt.axis('off')
plt.show()

# 6. EDGE DETECTION
canny = cv2.Canny(gray, 50, 150)
sobelx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=5)
sobely = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=5)
laplace = cv2.Laplacian(gray, cv2.CV_64F)

plt.figure(figsize=(10, 8))
plt.subplot(2, 2, 1); plt.imshow(canny, cmap='gray'); plt.title("Canny")
plt.subplot(2, 2, 2); plt.imshow(sobelx, cmap='gray'); plt.title("Sobel X")
plt.subplot(2, 2, 3); plt.imshow(sobely, cmap='gray'); plt.title("Sobel Y")
plt.subplot(2, 2, 4); plt.imshow(laplace, cmap='gray'); plt.title("Laplacian")
plt.show()

# 7. THRESHOLDING
_, th1 = cv2.threshold(gray, 120, 255, cv2.THRESH_BINARY)
_, th2 = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

th3 = cv2.adaptiveThreshold(gray, 255,
                             cv2.ADAPTIVE_THRESH_MEAN_C,
                             cv2.THRESH_BINARY, 11, 2)

th4 = cv2.adaptiveThreshold(gray, 255,
                             cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
                             cv2.THRESH_BINARY, 11, 2)

plt.figure(figsize=(10, 8))
plt.subplot(2, 2, 1); plt.imshow(th1, cmap='gray'); plt.title("Simple")
plt.subplot(2, 2, 2); plt.imshow(th2, cmap='gray'); plt.title("Otsu")
plt.subplot(2, 2, 3); plt.imshow(th3, cmap='gray'); plt.title("Adaptive Mean")
plt.subplot(2, 2, 4); plt.imshow(th4, cmap='gray'); plt.title("Adaptive Gaussian")
plt.show()

# 8. MORPHOLOGICAL TRANSFORMATIONS
kernel = np.ones((5, 5), np.uint8)

erode = cv2.erode(th1, kernel, iterations=1)
dilate = cv2.dilate(th1, kernel, iterations=1)
opening = cv2.morphologyEx(th1, cv2.MORPH_OPEN, kernel)
closing = cv2.morphologyEx(th1, cv2.MORPH_CLOSE, kernel)

plt.figure(figsize=(10, 8))
plt.subplot(2, 2, 1); plt.imshow(erode, cmap='gray'); plt.title("Erosion")
plt.subplot(2, 2, 2); plt.imshow(dilate, cmap='gray'); plt.title("Dilation")
plt.subplot(2, 2, 3); plt.imshow(opening, cmap='gray'); plt.title("Opening")
plt.subplot(2, 2, 4); plt.imshow(closing, cmap='gray'); plt.title("Closing")
plt.show()

# 9. CONTOURS
binary = th2.copy()
contours, hierarchy = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

cont_img = img.copy()
cv2.drawContours(cont_img, contours, -1, (0, 255, 0), 2)

plt.imshow(cv2.cvtColor(cont_img, cv2.COLOR_BGR2RGB))
plt.title("Contours Detected")
plt.axis('off')
plt.show()

# 10. HAAR CASCADE FACE DETECTION
face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")

faces = face_cascade.detectMultiScale(gray,
                                       scaleFactor=1.1,
                                       minNeighbors=5,
                                       minSize=(30, 30))

face_img = img.copy()
for (x, y, w, h) in faces:
    cv2.rectangle(face_img, (x, y), (x + w, y + h), (0, 255, 0), 2)

plt.imshow(cv2.cvtColor(face_img, cv2.COLOR_BGR2RGB))
plt.title("Face Detection")
plt.axis('off')
plt.show()